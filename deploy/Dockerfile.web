FROM node:22-bookworm AS admin-build

WORKDIR /workspace/admin-web
COPY admin-web/package.json admin-web/package-lock.json ./
RUN npm ci
COPY admin-web ./
RUN npm run build

FROM node:22-bookworm AS mobile-build

WORKDIR /workspace/mobile-uniapp
ARG MOBILE_BASE=/mobile/
COPY mobile-uniapp/package.json mobile-uniapp/package-lock.json ./
RUN npm ci
COPY mobile-uniapp ./
RUN VITE_BASE=$MOBILE_BASE npm run build:h5

FROM nginx:1.27-alpine

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-build /workspace/admin-web/dist /usr/share/nginx/html
COPY --from=mobile-build /workspace/mobile-uniapp/dist/build/h5-release /usr/share/nginx/html/mobile

EXPOSE 80
