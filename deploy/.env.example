# Copy this file to .env on the deployment server. Do not commit .env.
MYSQL_DATABASE=edu_admin
MYSQL_USER=edu_admin
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
DOMAIN=your-domain.example
APP_ORIGIN=https://your-domain.example
BACKEND_IMAGE=ghcr.io/your-github-owner/educational-administration-backend:replace-with-image-tag
WEB_IMAGE=ghcr.io/your-github-owner/educational-administration-web:replace-with-image-tag
