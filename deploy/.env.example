# Copy this file to .env on the deployment server. Do not commit .env.
MYSQL_DATABASE=edu_admin
MYSQL_USER=edu_admin
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Use http://<server-ip> for temporary IP access, or a bare domain name to
# enable Caddy's automatic HTTPS once DNS points to the server.
SITE_ADDRESS=http://your-server-ip
APP_ORIGIN=http://your-server-ip
BACKEND_IMAGE=your-acr-registry/your-namespace/educational-administration-backend:replace-with-image-tag
WEB_IMAGE=your-acr-registry/your-namespace/educational-administration-web:replace-with-image-tag
